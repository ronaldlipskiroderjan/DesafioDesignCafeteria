@baseUrl = http://localhost:8080
@adicionalNome = Leite%20vegetal
@itemNome = Cappuccino
@idInexistente = Inexistente
@pedidoInexistente = 00000000-0000-0000-0000-000000000000

### PREPARAÇÃO - Limpar adicional anterior
DELETE {{baseUrl}}/v1/adicionais/id/{{adicionalNome}}
Accept: application/json

> {%
    client.test("Preparação do adicional", function () {
        client.assert(response.status === 200 || response.status === 404, "Esperado 200 ou 404");
    });
%}

### PREPARAÇÃO - Limpar item anterior
DELETE {{baseUrl}}/v1/itens/id/{{itemNome}}
Accept: application/json

> {%
    client.test("Preparação do item", function () {
        client.assert(response.status === 200 || response.status === 404, "Esperado 200 ou 404");
    });
%}

### ADICIONAIS - Cadastrar
POST {{baseUrl}}/v1/adicionais
Content-Type: application/json
Accept: application/json

{
  "nome": "Leite vegetal",
  "valor": 3.50
}

> {%
    client.test("Adicional cadastrado", function () {
        client.assert(response.status === 201, "Esperado 201");
    });
%}

### ADICIONAIS - Rejeitar duplicado
POST {{baseUrl}}/v1/adicionais
Content-Type: application/json
Accept: application/json

{
  "nome": "Leite vegetal",
  "valor": 3.50
}

> {%
    client.test("Adicional duplicado retorna 409", function () {
        client.assert(response.status === 409, "Esperado 409");
        client.assert(response.body.code === 409, "Código JSON deve ser 409");
    });
%}

### ADICIONAIS - Listar
GET {{baseUrl}}/v1/adicionais
Accept: application/json

> {%
    client.test("Listagem contém o adicional", function () {
        client.assert(response.status === 200, "Esperado 200");
        client.assert(response.body.some(a => a.nome === "Leite vegetal" && Number(a.valor) === 3.5), "Adicional não encontrado");
    });
%}

### ADICIONAIS - Atualizar
PUT {{baseUrl}}/v1/adicionais/id/{{adicionalNome}}
Content-Type: application/json
Accept: application/json

{
  "nome": "Leite vegetal",
  "valor": 4.00
}

> {%
    client.test("Adicional atualizado", function () {
        client.assert(response.status === 202, "Esperado 202");
    });
%}

### ADICIONAIS - Atualizar inexistente
PUT {{baseUrl}}/v1/adicionais/id/{{idInexistente}}
Content-Type: application/json
Accept: application/json

{
  "nome": "Inexistente",
  "valor": 1.00
}

> {%
    client.test("Adicional inexistente retorna 404", function () {
        client.assert(response.status === 404, "Esperado 404");
        client.assert(response.body.code === 404, "Código JSON deve ser 404");
    });
%}

