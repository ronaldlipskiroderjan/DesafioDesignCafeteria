        client.assert(response.body.code === 409, "Código JSON deve ser 409");
    });
%}

### ITENS - Listar
GET {{baseUrl}}/v1/itens
Accept: application/json

> {%
    client.test("Listagem contém o item", function () {
        client.assert(response.status === 200, "Esperado 200");
        client.assert(response.body.some(i => i.nome === "Cappuccino" && Number(i.valor) === 9.5), "Item não encontrado");
    });
%}

### ITENS - Atualizar
PUT {{baseUrl}}/v1/itens/id/{{itemNome}}
Content-Type: application/json
Accept: application/json

{
  "nome": "Cappuccino",
  "valor": 12.00
}

> {%
    client.test("Item atualizado", function () {
        client.assert(response.status === 202, "Esperado 202");
    });
%}

### ITENS - Atualizar inexistente
PUT {{baseUrl}}/v1/itens/id/{{idInexistente}}
Content-Type: application/json
Accept: application/json

{
  "nome": "Inexistente",
  "valor": 1.00
}

> {%
    client.test("Item inexistente retorna 404", function () {
        client.assert(response.status === 404, "Esperado 404");
        client.assert(response.body.code === 404, "Código JSON deve ser 404");
    });
%}

### PEDIDOS - Criar e capturar UUID
# Valor esperado: (12.00 + (4.00 * 2 adicionais)) * 2 itens = 40.00
POST {{baseUrl}}/v1/pedidos
Content-Type: application/json
Accept: application/json

{
  "nomeCliente": "Maria Silva",
  "itens": [
    {
      "nome": "Cappuccino",
      "adicionais": [
        {
          "nome": "Leite vegetal",
          "quantidade": 2
        }
      ],
      "quantidade": 2
    }
  ]
}

> {%
    const pedidoId = String(response.body).replace(/^"|"$/g, "");
    client.global.set("pedidoId", pedidoId);
    client.test("Pedido criado e UUID retornado", function () {
        client.assert(response.status === 201, "Esperado 201");
        client.assert(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(pedidoId), "UUID inválido");
    });
%}

### PEDIDOS - Buscar criado
GET {{baseUrl}}/v1/pedidos/id/{{pedidoId}}
Accept: application/json

> {%
    client.test("Pedido pendente encontrado", function () {
        client.assert(response.status === 200, "Esperado 200");
        client.assert(response.body.nomeCliente === "Maria Silva", "Cliente incorreto");
        client.assert(response.body.status === "PENDENTE", "Status deve ser PENDENTE");
        client.assert(response.body.itens[0].quantidade === 2, "Quantidade do item incorreta");
        client.assert(response.body.itens[0].adicionais[0].quantidade === 2, "Quantidade do adicional incorreta");
    });
%}

### PEDIDOS - Fechar
PATCH {{baseUrl}}/v1/pedidos/id/{{pedidoId}}
Accept: application/json

> {%
    client.test("Pedido fechado", function () {
        client.assert(response.status === 202, "Esperado 202");
    });
%}

### PEDIDOS - Confirmar fechamento
GET {{baseUrl}}/v1/pedidos/id/{{pedidoId}}
Accept: application/json

> {%
    client.test("Fechamento persistido", function () {
        client.assert(response.status === 200, "Esperado 200");
        client.assert(response.body.status === "FECHADO", "Status deve ser FECHADO");
    });
%}

### PEDIDOS - Rejeitar segundo fechamento
PATCH {{baseUrl}}/v1/pedidos/id/{{pedidoId}}
Accept: application/json

> {%
    client.test("Pedido já fechado retorna 400", function () {
        client.assert(response.status === 400, "Esperado 400");
        client.assert(response.body.code === 400, "Código JSON deve ser 400");
    });
%}

### PEDIDOS - Buscar inexistente
GET {{baseUrl}}/v1/pedidos/id/{{pedidoInexistente}}
Accept: application/json

> {%
    client.test("Pedido inexistente retorna 404", function () {
        client.assert(response.status === 404, "Esperado 404");
        client.assert(response.body.code === 404, "Código JSON deve ser 404");
    });
%}

### PEDIDOS - Fechar inexistente
PATCH {{baseUrl}}/v1/pedidos/id/{{pedidoInexistente}}
Accept: application/json

> {%
    client.test("Fechamento inexistente retorna 404", function () {
        client.assert(response.status === 404, "Esperado 404");
        client.assert(response.body.code === 404, "Código JSON deve ser 404");
    });
%}

