POST {{baseUrl}}/v1/itens
Content-Type: application/json
Accept: application/json

{
  "nome": "Cappuccino",
  "valor": 9.50
}

> {%
    client.test("Item cadastrado", function () {
        client.assert(response.status === 201, "Esperado 201");
    });
%}

### ITENS - Rejeitar duplicado
POST {{baseUrl}}/v1/itens
Content-Type: application/json
Accept: application/json

{
  "nome": "Cappuccino",
  "valor": 9.50
}

> {%
    client.test("Item duplicado retorna 409", function () {
